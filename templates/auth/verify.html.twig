{% extends 'base.html.twig' %}

{% block title %}Konvix Music | Vérification{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-5">
                    <div class="auth-card">
                        <div class="card-body p-4 p-lg-5">
                            <div class="text-center mb-4">
                                <div class="brand-badge mx-auto mb-3">✓</div>
                                <p class="text-uppercase small text-secondary-light mb-1">Étape 2</p>
                                <h1 class="h3 mb-0 text-white">Vérification du compte</h1>
                                <p class="text-white-50 mt-2 mb-0">Votre compte a été créé, mais il est encore en attente de validation.</p>
                            </div>

                            {% for label, messages in app.flashes %}
                                {% for message in messages %}
                                    <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'warning' ? 'warning' : (label == 'info' ? 'info' : 'success')) }} auth-alert" role="alert">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                            {% endfor %}

                            {% if errors is not empty %}
                                <div class="alert alert-danger auth-alert" role="alert">
                                    <ul class="mb-0 ps-3">
                                        {% for error in errors %}
                                            <li>{{ error }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}

                            <form method="post" novalidate>
                                <div class="mb-3">
                                    <label for="email" class="form-label text-white-50">Email</label>
                                    <input type="email" class="form-control form-control-lg auth-input" id="email" name="email" value="{{ email|default('') }}" placeholder="artist@example.com" required>
                                </div>

                                <div class="mb-3">
                                    <label for="code" class="form-label text-white-50">Code de vérification</label>
                                    <input type="text" class="form-control form-control-lg auth-input" id="code" name="code" inputmode="numeric" maxlength="6" placeholder="123456" required>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Valider mon compte</button>
                            </form>

                            <form method="post" action="{{ path('app_verify_resend') }}" class="mt-3">
                                <input type="hidden" name="email" value="{{ email|default('') }}">
                                <button type="submit" class="btn btn-outline-light w-100">Renvoyer le code</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
