{% extends 'base.html.twig' %}

{% block title %}Konvix Music | Connexion{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <div class="container py-5 py-lg-6">
            <div class="row justify-content-center align-items-center g-4">
                <div class="col-12 col-lg-6">
                    <div class="auth-copy">
                        <p class="eyebrow text-uppercase mb-3">Welcome back</p>
                        <h1 class="display-4 fw-bold mb-4">Accédez à votre espace.</h1>
                        <p class="lead text-secondary-light mb-4">
                            Connectez-vous à votre compte artiste ou auditeur pour continuer votre parcours musical.
                        </p>

                        <div class="d-flex flex-wrap gap-3">
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">Artiste</span>
                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis px-3 py-2">Auditeur</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="auth-card">
                        <div class="card-body p-4 p-lg-5">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div>
                                    <p class="text-uppercase small text-secondary-light mb-1">Connexion</p>
                                    <h2 class="h4 mb-0 text-white">Se connecter</h2>
                                </div>
                                <div class="brand-badge">KM</div>
                            </div>

                            {% if error %}
                                <div class="alert alert-danger auth-alert" role="alert">
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}

                            <form method="post" action="{{ path('app_login') }}" novalidate>
                                <div class="mb-3">
                                    <label for="username" class="form-label text-white-50">Email</label>
                                    <input type="email" class="form-control form-control-lg auth-input" id="username" name="_username" value="{{ last_username }}" placeholder="artist@example.com" required>
                                </div>

                                <div class="mb-3">
                                    <label for="password" class="form-label text-white-50">Mot de passe</label>
                                    <input type="password" class="form-control form-control-lg auth-input" id="password" name="_password" placeholder="••••••••" required>
                                </div>

                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Se connecter</button>
                                <p class="text-center text-white-50 mt-3 mb-0 small">
                                    Pas encore inscrit ? <a href="{{ path('app_register') }}" class="text-decoration-none link-primary">Créer un compte artiste</a>
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
