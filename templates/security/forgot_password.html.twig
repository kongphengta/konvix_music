{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-brand">
                <span>♪</span>
                <h1>Konvix Music</h1>
            </div>

            <h2>Mot de passe oublié</h2>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-message flash-{{ label }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('app_forgot_password') }}">
                <div>
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required autofocus>
                </div>

                <button class="btn btn-primary" type="submit">Envoyer le lien</button>
            </form>

            <p class="auth-link-row">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </p>
        </section>
    </main>
{% endblock %}
