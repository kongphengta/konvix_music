{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié – Konvix Music{% endblock %}

{% block body %}
<div class="container py-5 auth-form-shell">
    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="fw-bold text-center mb-1">Mot de passe oublié</h2>
            <p class="text-center text-muted mb-4">
                Saisissez votre adresse email pour recevoir un lien de réinitialisation.
            </p>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('app_forgot_password') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">Email</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="exemple@email.com" required>
                </div>

                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">
                    Envoyer le lien
                </button>
            </form>

            <hr class="my-4">
            <p class="text-center text-muted mb-0">
                Vous vous souvenez de votre mot de passe ?
                <a href="{{ path('app_login') }}" class="fw-semibold text-dark">Se connecter</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
