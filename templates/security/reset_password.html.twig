{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-brand">
                <span>♪</span>
                <h1>Konvix Music</h1>
            </div>

            <h2>Réinitialiser le mot de passe</h2>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-message flash-{{ label }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('app_reset_password', {'token': token}) }}">
                <input type="hidden" name="token" value="{{ token }}">

                <div>
                    <label for="newPassword">Nouveau mot de passe</label>
                    <input type="password" id="newPassword" name="newPassword" required>
                </div>

                <div>
                    <label for="confirmPassword">Confirmer le mot de passe</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required>
                </div>

                <button class="btn btn-primary" type="submit">Réinitialiser le mot de passe</button>
            </form>

            <p class="auth-link-row">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </p>
        </section>
    </main>
{% endblock %}
