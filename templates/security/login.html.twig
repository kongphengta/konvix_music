{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-brand">
                <span>♪</span>
                <h1>Konvix Music</h1>
            </div>

            <h2>Connexion</h2>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-message flash-{{ label }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% if error %}
                <div class="flash-message flash-error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>

                <form method="post" action="{{ path('app_verify_email_resend') }}" class="mt-3">
                    <input type="hidden" name="email" value="{{ last_username|default('') }}">
                    <button class="btn btn-link p-0 text-decoration-none" type="submit">Renvoyer le code</button>
                </form>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div>
                    <label for="username">Email</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
                </div>

                <div>
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary" type="submit">Se connecter</button>
            </form>

            <p class="auth-link-row">
                Pas encore inscrit ? <a href="{{ path('app_register') }}">Créer un compte</a>
            </p>
        </section>
    </main>
{% endblock %}
