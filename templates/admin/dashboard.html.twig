{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
	<div class="container-fluid">

		<div class="row mb-4">
			<div class="col">
				<h1 class="mb-3">Bienvenue dans l’Admin Konvix Music</h1>
				<p class="text-muted">
					Gérez vos chansons, catégories et albums depuis ce tableau de bord.
				</p>
			</div>
		</div>

		<div class="row">
			<div class="col-md-4">
				<a href="{{ path('admin_dashboard', { crudControllerFqcn: 'App\\Controller\\Admin\\SongCrudController', crudAction: 'new' }) }}" class="btn btn-primary btn-lg w-100">
					Ajouter une nouvelle chanson
				</a>
			</div>
		</div>

	</div>
{% endblock %}
