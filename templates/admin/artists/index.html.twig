{% extends 'base.html.twig' %}

{% block title %}Gestion des artistes{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main>
        <section class="page-hero">
            <div class="container page-hero-inner">
                <div>
                    <span class="eyebrow">Admin</span>
                    <h1>Gestion des artistes</h1>
                    <p class="lead">Créer, modifier et supprimer les profils artistes depuis la base de données.</p>
                </div>
                <a class="btn btn-primary" href="{{ path('app_admin_artists_new') }}">Ajouter un artiste</a>
            </div>
        </section>

        <section class="section">
            <div class="container">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash-message flash-{{ label }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                <div class="admin-list">
                    {% for artist in artists %}
                        <article class="admin-item">
                            <div class="admin-item-visual admin-{{ artist.color }}" aria-hidden="true"></div>
                            <div class="admin-item-body">
                                <div class="admin-item-meta">
                                    <span>{{ artist.genre }}</span>
                                    <span>{{ artist.city }}</span>
                                </div>
                                <h2>{{ artist.name }}</h2>
                                <p>{{ artist.bio ?: 'Aucune bio pour l’instant.' }}</p>
                                <div class="admin-item-actions">
                                    <a class="btn btn-secondary" href="{{ path('app_admin_artists_edit', {'id': artist.id}) }}">Modifier</a>
                                    <form method="post" action="{{ path('app_admin_artists_delete', {'id': artist.id}) }}" onsubmit="return confirm('Supprimer cet artiste ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ artist.id) }}">
                                        <button class="btn btn-danger" type="submit">Supprimer</button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
