{% extends 'base.html.twig' %}

{% block title %}Vérification email{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-brand">
                <span>♪</span>
                <h1>Konvix Music</h1>
            </div>

            <h2>Vérifier votre email</h2>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-message flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <p>Nous avons envoyé un code à 6 chiffres à <strong>{{ email }}</strong>.</p>

            <form method="post" action="{{ path('app_verify_email', { email: email }) }}">
                <label for="code">Code de vérification</label>
                <input type="text" id="code" name="code" inputmode="numeric" maxlength="6" pattern="\d{6}" required autofocus>
                <input type="hidden" name="email" value="{{ email }}">

                <button class="btn btn-primary" type="submit">Valider mon compte</button>
            </form>

            <form method="post" action="{{ path('app_verify_email_resend') }}" class="mt-3">
                <input type="hidden" name="email" value="{{ email }}">
                <button class="btn btn-link p-0 text-decoration-none" type="submit">Renvoyer le code</button>
            </form>
        </section>
    </main>
{% endblock %}
