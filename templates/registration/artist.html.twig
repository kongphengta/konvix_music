{% extends 'base.html.twig' %}

{% block title %}Inscription Artiste – Konvix Music{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 720px;">

    {# En-tête #}
    <div class="text-center mb-4">
        <span class="badge bg-dark fs-6 px-3 py-2 mb-2">🎤 Espace Artiste</span>
        <h2 class="fw-bold">Rejoignez Konvix Music en tant qu'artiste</h2>
        <p class="text-muted">Publiez vos chansons, touchez vos fans, développez votre audience.</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success text-center">{{ message }}</div>
    {% endfor %}

    <form method="post" enctype="multipart/form-data" novalidate>

        {# ── Étape 1 : Compte ─────────────────────────────────── #}
        <div class="card shadow border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">
                    <span class="badge bg-dark me-2">1</span>Informations du compte
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(accountForm.firstName, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(accountForm.firstName, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(accountForm.firstName) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(accountForm.lastName, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(accountForm.lastName, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(accountForm.lastName) }}</div>
                    </div>
                    <div class="col-12">
                        {{ form_label(accountForm.email, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(accountForm.email, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(accountForm.email) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(accountForm.plainPassword.first, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(accountForm.plainPassword.first, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(accountForm.plainPassword.first) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(accountForm.plainPassword.second, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(accountForm.plainPassword.second, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(accountForm.plainPassword.second) }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Étape 2 : Profil artiste ──────────────────────────── #}
        <div class="card shadow border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">
                    <span class="badge bg-dark me-2">2</span>Votre profil artiste
                </h5>

                {{ form_errors(profileForm) }}

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(profileForm.stageName, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(profileForm.stageName, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(profileForm.stageName) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(profileForm.genre, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(profileForm.genre, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(profileForm.genre) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(profileForm.country, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(profileForm.country, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(profileForm.country) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(profileForm.website, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(profileForm.website, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(profileForm.website) }}</div>
                    </div>
                    <div class="col-12">
                        {{ form_label(profileForm.bio, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(profileForm.bio, { attr: { class: 'form-control' } }) }}
                        <div class="text-danger small">{{ form_errors(profileForm.bio) }}</div>
                    </div>
                    <div class="col-12">
                        {{ form_label(profileForm.photoFile, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(profileForm.photoFile) }}
                        <div class="form-text text-muted">JPG, PNG ou WebP – max 5 Mo</div>
                        <div class="text-danger small">{{ form_errors(profileForm.photoFile) }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Conditions ────────────────────────────────────────── #}
        <div class="mb-4 form-check">
            {{ form_widget(accountForm.agreeTerms, { attr: { class: 'form-check-input' } }) }}
            {{ form_label(accountForm.agreeTerms, null, { label_attr: { class: 'form-check-label text-muted' } }) }}
            <div class="text-danger small">{{ form_errors(accountForm.agreeTerms) }}</div>
        </div>

        {# Tokens CSRF des deux formulaires #}
        {{ form_row(accountForm._token) }}
        {{ form_row(profileForm._token) }}

        <button type="submit" class="btn btn-dark w-100 py-2 fw-bold fs-5">
            🎤 Créer mon compte artiste
        </button>

    </form>

    <p class="text-center text-muted mt-4 mb-0">
        Vous êtes auditeur ?
        <a href="{{ path('app_register') }}" class="fw-semibold text-dark">Inscription gratuite ici</a>
    </p>

</div>
{% endblock %}
