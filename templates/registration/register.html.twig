{% extends 'base.html.twig' %}

{% block title %}Inscription {{ accountLabel }}{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-brand">
                <span>♪</span>
                <h1>Konvix Music</h1>
            </div>

            <h2>Créer un compte {{ accountLabel }}</h2>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-message flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {{ form_start(registrationForm) }}
                <div class="form-grid">
                    <div>{{ form_row(registrationForm.firstName) }}</div>
                    <div>{{ form_row(registrationForm.lastName) }}</div>
                    <div>{{ form_row(registrationForm.email) }}</div>
                    <div>{{ form_row(registrationForm.plainPassword.first) }}</div>
                    <div>{{ form_row(registrationForm.plainPassword.second) }}</div>
                </div>

                <button class="btn btn-primary" type="submit">Créer mon compte</button>
            {{ form_end(registrationForm) }}
        </section>
    </main>
{% endblock %}
