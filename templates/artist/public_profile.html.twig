{% extends 'base.html.twig' %}

{% block title %}Konvix Music | {{ profile.artistName }}{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="app-shell">
        <div class="container py-5">
            <div class="auth-card overflow-hidden">
                <div class="bg-dark border-bottom border-secondary p-4 p-lg-5">
                    <div class="row align-items-center g-4">
                        <div class="col-md-3 text-center text-md-start">
                            <div class="rounded-circle border border-secondary d-inline-flex align-items-center justify-content-center text-white fw-bold bg-primary-subtle" style="width: 96px; height: 96px; font-size: 2rem;">
                                {{ profile.artistName|first|upper }}
                            </div>
                        </div>

                        <div class="col-md-9">
                            <p class="text-uppercase small text-secondary-light mb-2">Artiste</p>
                            <h1 class="h2 mb-2 text-white">{{ profile.artistName }}</h1>
                            <p class="text-white-50 mb-2">@{{ profile.slug }}</p>
                            {% if profile.city or profile.country %}
                                <p class="text-white-50 mb-0">{{ profile.city|default('') }}{% if profile.city and profile.country %} · {% endif %}{{ profile.country|default('') }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-lg-5">
                    {% if profile.bio %}
                        <div class="mb-4">
                            <p class="text-uppercase small text-secondary-light mb-2">Bio</p>
                            <p class="text-white-50 mb-0">{{ profile.bio }}</p>
                        </div>
                    {% endif %}

                    {% if tracks is empty %}
                        <div class="border border-secondary rounded-4 p-4 text-center">
                            <p class="text-white-50 mb-0">Cet artiste n’a pas encore publié de morceau.</p>
                        </div>
                    {% else %}
                        <div class="row g-4">
                            {% for track in tracks %}
                                <div class="col-lg-6">
                                    <article class="border border-secondary rounded-4 p-3 h-100">
                                        {% if track.coverImageName %}
                                            <img src="{{ asset('uploads/tracks/covers/' ~ track.coverImageName) }}" alt="{{ track.title }}" class="img-fluid rounded mb-3" style="height: 220px; width: 100%; object-fit: cover;">
                                        {% else %}
                                            <div class="bg-dark border border-secondary rounded mb-3 d-flex align-items-center justify-content-center text-white-50" style="height: 220px; width: 100%;">
                                                Pas de couverture
                                            </div>
                                        {% endif %}

                                        <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                                            <h2 class="h5 text-white mb-0">{{ track.title }}</h2>
                                            <span class="text-white-50 small">{{ track.createdAt|date('d/m/Y') }}</span>
                                        </div>

                                        {% if track.audioFileName %}
                                            <audio controls class="w-100" preload="none">
                                                <source src="{{ asset('uploads/tracks/audio/' ~ track.audioFileName) }}" type="audio/mpeg">
                                                Votre navigateur ne supporte pas l’écoute audio.
                                            </audio>
                                        {% else %}
                                            <p class="text-white-50 small mb-0">Aucun aperçu audio disponible.</p>
                                        {% endif %}
                                    </article>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
