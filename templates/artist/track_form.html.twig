{% extends 'base.html.twig' %}

{% block title %}Konvix Music | Ajouter un morceau{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-7">
                    <div class="auth-card">
                        <div class="card-body p-4 p-lg-5">
                            <div class="mb-4">
                                <p class="text-uppercase small text-secondary-light mb-1">Étape 4</p>
                                <h1 class="h3 mb-1 text-white">Ajouter un morceau</h1>
                                <p class="mb-0 text-white-50">Téléversez votre audio et la couverture de votre morceau.</p>
                            </div>

                            {% if errors is not empty %}
                                <div class="alert alert-danger auth-alert" role="alert">
                                    <ul class="mb-0 ps-3">
                                        {% for error in errors %}
                                            <li>{{ error }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}

                            <form method="post" enctype="multipart/form-data" novalidate data-turbo="false">
                                <div class="mb-3">
                                    <label for="title" class="form-label text-white-50">Titre du morceau <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-lg auth-input" id="title" name="title" value="{{ formData.title|default('') }}" placeholder="Midnight Echo" required>
                                </div>

                                <div class="mb-3">
                                    <label for="audioFile" class="form-label text-white-50">Fichier audio <span class="text-danger">*</span></label>
                                    <div class="file-upload-wrapper">
                                        <input type="file" class="form-control form-control-lg auth-input" id="audioFile" name="audioFile" accept=".mp3,.wav,.aac,.ogg,audio/mpeg,audio/wav,audio/ogg" required data-file-input="audio">
                                        <small class="text-white-50 d-block mt-2">Format accepté: MP3, WAV, AAC, OGG (max 80 Mo)</small>
                                        <div class="mt-2 audio-preview" id="audioPreview" style="display: none;">
                                            <small class="text-success">✓ <span class="audio-name"></span></small>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="coverImage" class="form-label text-white-50">Pochette (optionnelle)</label>
                                    <div class="file-upload-wrapper">
                                        <input type="file" class="form-control form-control-lg auth-input" id="coverImage" name="coverImage" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-file-input="cover">
                                        <small class="text-white-50 d-block mt-2">Format accepté: JPG, PNG, WebP (max 5 Mo)</small>
                                        <div class="mt-2 image-preview" id="imagePreview" style="display: none;">
                                            <img id="previewImage" src="" alt="Aperçu" class="img-fluid rounded" style="max-height: 150px; max-width: 150px;">
                                        </div>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Enregistrer le morceau</button>
                                <a href="{{ path('app_artist_tracks') }}" class="btn btn-outline-secondary btn-lg w-100 mt-2">Annuler</a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {% include '_partials/footer.html.twig' %}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const audioInput = document.querySelector('[data-file-input="audio"]');
            const coverInput = document.querySelector('[data-file-input="cover"]');
            const audioPreview = document.getElementById('audioPreview');
            const imagePreview = document.getElementById('imagePreview');
            const audioName = audioPreview ? audioPreview.querySelector('.audio-name') : null;
            const previewImage = document.getElementById('previewImage');

            if (audioInput) {
                audioInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file && audioPreview && audioName) {
                        audioName.textContent = file.name;
                        audioPreview.style.display = 'block';
                    } else if (audioPreview) {
                        audioPreview.style.display = 'none';
                    }
                });
            }

            if (coverInput) {
                coverInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file && imagePreview && previewImage) {
                        const reader = new FileReader();
                        reader.onload = function(event) {
                            previewImage.src = event.target.result;
                            imagePreview.style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    } else if (imagePreview) {
                        imagePreview.style.display = 'none';
                    }
                });
            }
        });
    </script>
{% endblock %}
