{% extends 'base.html.twig' %}

{% block title %}Espace artiste{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main>
        <section class="page-hero small-hero">
            <div class="container page-hero-inner">
                <div>
                    <span class="eyebrow">Artiste</span>
                    <h1>Mon espace artiste</h1>
                </div>
                <a class="btn btn-primary" href="{{ path('app_artist_profile_new') }}">Créer un profil</a>
            </div>
        </section>

        <section class="section">
            <div class="container">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash-message flash-{{ label }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                <div class="artist-dashboard-list">
                    {% for artist in artists %}
                        <article class="admin-item">
                            <div class="admin-item-visual admin-{{ artist.color }}" aria-hidden="true"></div>
                            <div class="admin-item-body">
                                <div class="admin-item-meta">
                                    <span>{{ artist.genre }}</span>
                                    <span>{{ artist.city }}</span>
                                </div>
                                <h2>{{ artist.name }}</h2>
                                <p>{{ artist.bio ?: 'Profil en cours de rédaction.' }}</p>
                                <div class="admin-item-actions">
                                    <span class="status-pill {% if artist.isPublished %}published{% else %}pending{% endif %}">
                                        {% if artist.isPublished %}Publié{% else %}En attente{% endif %}
                                    </span>
                                </div>
                            </div>
                        </article>
                    {% else %}
                        <p>Aucun profil artiste pour le moment.</p>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
