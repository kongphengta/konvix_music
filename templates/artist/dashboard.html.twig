{% extends 'base.html.twig' %}

{% block title %}Konvix Music | Espace artiste{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <div class="container py-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'warning' ? 'warning' : (label == 'info' ? 'info' : 'success')) }} auth-alert mb-4" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="row g-4 align-items-stretch">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                        <div>
                            <p class="text-uppercase small text-secondary-light mb-1">Espace artiste</p>
                            <h1 class="h3 mb-0 text-white">Bienvenue, {{ user.firstName }} {{ user.lastName }}</h1>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="{{ path('app_artist_profile') }}" class="btn btn-outline-light">Modifier mon profil</a>
                            {% if profile.slug is defined and profile.slug %}
                                <a href="{{ path('app_artist_public', {'slug': profile.slug}) }}" class="btn btn-primary">Voir ma page publique</a>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="auth-card h-100">
                        <div class="card-body p-4">
                            <p class="text-uppercase small text-secondary-light mb-2">Profil</p>
                            <h2 class="h5 text-white mb-3">{{ profile.artistName }}</h2>
                            <p class="text-white-50 mb-2">{{ profile.bio|default('Aucune bio pour le moment.') }}</p>
                            <p class="text-white-50 mb-0">{{ profile.city|default('Ville non renseignée') }} · {{ profile.country|default('Pays non renseigné') }}</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="auth-card h-100">
                        <div class="card-body p-4">
                            <p class="text-uppercase small text-secondary-light mb-2">Activité</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="border border-secondary rounded-4 p-3 h-100">
                                        <div class="text-white-50 small">Morceaux</div>
                                        <div class="display-6 text-white mt-2">{{ trackCount ?? 0 }}</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="border border-secondary rounded-4 p-3 h-100">
                                        <div class="text-white-50 small">Écoutes</div>
                                        <div class="display-6 text-white mt-2">0</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4">
                                <a href="{{ path('app_artist_tracks_new') }}" class="btn btn-primary btn-lg w-100">Publier un morceau</a>
                                <a href="{{ path('app_artist_tracks') }}" class="btn btn-outline-light btn-lg w-100 mt-2">Gérer mes morceaux</a>
                                <p class="text-white-50 small mt-2 mb-0">Téléversez votre audio et votre couverture en quelques clics.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
