{% extends 'base.html.twig' %}

{% block title %}Konvix Music | Mes morceaux{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <div class="container py-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'warning' ? 'warning' : (label == 'info' ? 'info' : 'success')) }} auth-alert mb-4" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <p class="text-uppercase small text-secondary-light mb-1">Mes morceaux</p>
                    <h1 class="h3 mb-0 text-white">Bibliothèque</h1>
                </div>
                <a href="{{ path('app_artist_tracks_new') }}" class="btn btn-primary">Ajouter un morceau</a>
            </div>

            {% if tracks is empty %}
                <div class="auth-card">
                    <div class="card-body p-4 text-center">
                        <p class="text-white-50 mb-3">Aucun morceau pour le moment.</p>
                        <a href="{{ path('app_artist_tracks_new') }}" class="btn btn-outline-light">Téléverser mon premier morceau</a>
                    </div>
                </div>
            {% else %}
                <div class="row g-4">
                    {% for track in tracks %}
                        <div class="col-md-6 col-xl-4">
                            <div class="auth-card h-100">
                                <div class="card-body p-3">
                                    {% if track.coverImageName %}
                                        <img src="{{ asset('uploads/tracks/covers/' ~ track.coverImageName) }}" alt="{{ track.title }}" class="img-fluid rounded mb-3" style="height: 180px; width: 100%; object-fit: cover;">
                                    {% else %}
                                        <div class="bg-dark border border-secondary rounded mb-3 d-flex align-items-center justify-content-center text-white-50" style="height: 180px; width: 100%;">
                                            Pas de couverture
                                        </div>
                                    {% endif %}

                                    <h2 class="h5 text-white mb-2">{{ track.title }}</h2>
                                    <p class="text-white-50 small mb-0">Ajouté le {{ track.createdAt|date('d/m/Y') }}</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
