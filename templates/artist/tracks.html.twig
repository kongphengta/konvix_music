{% extends 'base.html.twig' %}

{% block title %}Konvix Music | Mes morceaux{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="auth-shell">
        <div class="container py-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'warning' ? 'warning' : (label == 'info' ? 'info' : 'success')) }} auth-alert mb-4" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <p class="text-uppercase small text-secondary-light mb-1">Mes morceaux</p>
                    <h1 class="h3 mb-0 text-white">Bibliothèque</h1>
                </div>
                <a href="{{ path('app_artist_tracks_new') }}" class="btn btn-primary">+ Ajouter un morceau</a>
            </div>

            {% if tracks is empty %}
                <div class="auth-card">
                    <div class="card-body p-4 p-lg-5 text-center">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">🎵</div>
                        <h2 class="h5 text-white mb-2">Aucun morceau pour le moment</h2>
                        <p class="text-white-50 mb-4">Commencez à partager votre musique avec vos auditeurs!</p>
                        <a href="{{ path('app_artist_tracks_new') }}" class="btn btn-primary">Téléverser mon premier morceau</a>
                    </div>
                </div>
            {% else %}
                <div class="row g-4">
                    {% for track in tracks %}
                        <div class="col-md-6 col-xl-4">
                            <div class="auth-card h-100 position-relative overflow-hidden">
                                <div class="card-body p-0">
                                    {% if track.coverImageName %}
                                        <img src="{{ asset('uploads/tracks/covers/' ~ track.coverImageName) }}" alt="{{ track.title }}" class="img-fluid" style="height: 200px; width: 100%; object-fit: cover;">
                                    {% else %}
                                        <div class="bg-dark border border-secondary d-flex align-items-center justify-content-center text-white-50" style="height: 200px; width: 100%; font-size: 3rem;">
                                            🎵
                                        </div>
                                    {% endif %}
                                    
                                    <div class="p-3">
                                        <h2 class="h6 text-white mb-1 text-truncate">{{ track.title }}</h2>
                                        <p class="text-white-50 small mb-3">{{ track.createdAt|date('d/m/Y à H:i') }}</p>
                                        
                                        {% if track.audioFileName %}
                                            <audio controls class="w-100 mb-3" style="height: 32px;">
                                                <source src="{{ asset('uploads/tracks/audio/' ~ track.audioFileName) }}" type="audio/mpeg">
                                                Votre navigateur ne supporte pas la balise audio.
                                            </audio>
                                        {% endif %}
                                        
                                        <div class="d-flex gap-2">
                                            <a href="#" class="btn btn-sm btn-outline-secondary flex-grow-1" title="Éditer">✏️ Éditer</a>
                                            <a href="#" class="btn btn-sm btn-outline-danger flex-grow-1" title="Supprimer">🗑️ Supprimer</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
