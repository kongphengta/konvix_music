{% extends 'base.html.twig' %}

{% block title %}Créer mon profil artiste{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="artist-profile-page py-5">
        <div class="container">
            <div class="card artist-profile-card border-0 shadow-lg">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                        <div>
                            <span class="eyebrow">Artiste</span>
                            <h1 class="artist-profile-title mt-3 mb-0">Créer mon profil</h1>
                        </div>

                        <a class="btn btn-outline-light btn-lg px-4" href="{{ path('app_artist_dashboard') }}">Retour</a>
                    </div>

                    {{ form_start(form, {'attr': {'class': 'artist-profile-form row g-4'}}) }}
                        <div class="col-md-6">
                            {{ form_row(form.slug, {
                                'attr': {'class': 'form-control form-control-lg bg-dark text-white border-secondary'},
                                'label_attr': {'class': 'form-label text-light fw-semibold'},
                                'row_attr': {'class': 'mb-0'}
                            }) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.name, {
                                'attr': {'class': 'form-control form-control-lg bg-dark text-white border-secondary'},
                                'label_attr': {'class': 'form-label text-light fw-semibold'},
                                'row_attr': {'class': 'mb-0'}
                            }) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.genre, {
                                'attr': {'class': 'form-control form-control-lg bg-dark text-white border-secondary'},
                                'label_attr': {'class': 'form-label text-light fw-semibold'},
                                'row_attr': {'class': 'mb-0'}
                            }) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.city, {
                                'attr': {'class': 'form-control form-control-lg bg-dark text-white border-secondary'},
                                'label_attr': {'class': 'form-label text-light fw-semibold'},
                                'row_attr': {'class': 'mb-0'}
                            }) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.followers, {
                                'attr': {'class': 'form-control form-control-lg bg-dark text-white border-secondary'},
                                'label_attr': {'class': 'form-label text-light fw-semibold'},
                                'row_attr': {'class': 'mb-0'}
                            }) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.color, {
                                'attr': {'class': 'form-select form-select-lg bg-dark text-white border-secondary'},
                                'label_attr': {'class': 'form-label text-light fw-semibold'},
                                'row_attr': {'class': 'mb-0'}
                            }) }}
                        </div>

                        <div class="col-12">
                            {{ form_row(form.bio, {
                                'attr': {'class': 'form-control form-control-lg bg-dark text-white border-secondary', 'rows': 5},
                                'label_attr': {'class': 'form-label text-light fw-semibold'},
                                'row_attr': {'class': 'mb-0'}
                            }) }}
                        </div>

                        <div class="col-12 mt-2">
                            <button class="btn btn-primary btn-lg w-100" type="submit">Enregistrer mon profil</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
