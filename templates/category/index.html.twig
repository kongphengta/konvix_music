{% extends 'base.html.twig' %}

{% block title %}Catégories
{% endblock %}

{% block body %}
	<h1 class="page-title">Catégories</h1>

	<div class="category-grid">
		{% for category in categories %}
			<a href="{{ path('app_category_show', { slug: category.slug }) }}" class="category-card">
				<div class="category-name">{{ category.name }}</div>
			</a>
		{% else %}
			<p>Aucune catégorie trouvée.</p>
		{% endfor %}
	</div>

	<style>
		.category-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
			gap: 20px;
			margin-top: 30px;
		}

		.category-card {
			padding: 20px;
			background: #222;
			color: white;
			border-radius: 8px;
			text-align: center;
			text-decoration: none;
			transition: 0.2s;
		}

		.category-card:hover {
			background: #444;
		}
	</style>
{% endblock %}
