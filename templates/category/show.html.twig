{% extends 'base.html.twig' %}

{% block title %}
	{{ category.name }}
{% endblock %}

{% block body %}
	<div class="category-header">
		<h1>{{ category.name }}</h1>
	</div>

	<div class="spotify-grid">
		{% for song in songs %}
			<div class="spotify-card">
				<div class="cover-wrapper">
					{% if song.image %}
						<img src="{{ asset('uploads/covers/' ~ song.image) }}" alt="{{ song.title }}" class="cover-img">
					{% else %}
						<img src="{{ asset('images/country-music.avif') }}" alt="{{ song.title }}" class="cover-img">
					{% endif %}
				</div>

				<div class="song-info">
					<h3 class="song-title">{{ song.title }}</h3>

					<audio controls class="audio-player">
						<source src="{{ path('app_stream_song', { slug: song.slug }) }}" type="{{ song.filename ends with '.wav' ? 'audio/wav' : 'audio/mpeg' }}">
					</audio>

					<a href="{{ path('app_song_show', { slug: song.slug }) }}" class="open-btn">
						Ouvrir →
					</a>
				</div>
			</div>
		{% else %}
			<p>Aucune chanson dans cette catégorie.</p>
		{% endfor %}
	</div>
{% endblock %}
