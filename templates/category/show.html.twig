{% extends 'base.html.twig' %}

{% block title %}
	{{ category.name }}
{% endblock %}

{% block body %}
	<div class="category-header">
		<h1>{{ category.name }}</h1>
	</div>

	<div class="spotify-grid">
		{% for song in songs %}
			<div class="spotify-card">
				<div class="cover-wrapper">
					{% if song.image %}
						<img src="{{ asset('uploads/covers/' ~ song.image) }}" alt="{{ song.title }}" class="cover-img">
					{% else %}
						<img src="{{ asset('images/country-music.avif') }}" alt="{{ song.title }}" class="cover-img">
					{% endif %}
				</div>

				<div class="song-info">
					<h3 class="song-title">{{ song.title }}</h3>

					<audio controls class="audio-player">
						<source src="{{ path('app_stream_song', { slug: song.slug }) }}" type="{{ song.filename ends with '.wav' ? 'audio/wav' : 'audio/mpeg' }}">
					</audio>

					<a href="{{ path('app_song_show', { slug: song.slug }) }}" class="open-btn">
						Ouvrir →
					</a>
				</div>
			</div>
		{% else %}
			<p>Aucune chanson dans cette catégorie.</p>
		{% endfor %}
	</div>

	<style>
		/* HEADER */
		.category-header {
			margin-bottom: 30px;
		}
		.category-header h1 {
			font-size: 42px;
			font-weight: 700;
			color: #fff;
		}

		/* GRID */
		.spotify-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
			gap: 25px;
		}

		/* CARD */
		.spotify-card {
			background: #181818;
			padding: 18px;
			border-radius: 12px;
			transition: transform 0.2s, background 0.2s;
			cursor: pointer;
		}
		.spotify-card:hover {
			background: #282828;
			transform: scale(1.03);
		}

		/* COVER */
		.cover-wrapper {
			width: 100%;
			aspect-ratio: 1 / 1;
			overflow: hidden;
			border-radius: 8px;
			margin-bottom: 12px;
		}
		.cover-img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		/* TEXT */
		.song-title {
			font-size: 18px;
			font-weight: 600;
			color: #fff;
			margin-bottom: 10px;
		}

		/* AUDIO */
		.audio-player {
			width: 100%;
			margin-bottom: 10px;
		}

		/* BUTTON */
		.open-btn {
			display: inline-block;
			padding: 6px 12px;
			background: #1DB954;
			color: #fff;
			border-radius: 20px;
			text-decoration: none;
			font-size: 14px;
			transition: background 0.2s;
		}
		.open-btn:hover {
			background: #1ed760;
		}
	</style>

{% endblock %}
