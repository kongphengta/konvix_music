{% extends 'base.html.twig' %}

{% block title %}Konvix Music — Accueil
{% endblock %}

{% block body %}


	<section class="py-5 bg-dark text-light text-center">
		<div class="container">
			<h1 class="display-4 fw-bold">Konvix Music</h1>
			<p class="lead mt-3">
				Le son moderne, l’énergie du dance country, et l’âme de Paksane.
			</p>
			<a href="{{ path('app_song_index') }}" class="btn btn-primary btn-lg mt-3">
				Écouter les chansons
			</a>
		</div>
	</section>

	<section class="py-5 bg-light">
		<div class="container">
			<h2 class="text-center mb-5">Découvrir</h2>

			<div class="row g-4">
				<div class="col-md-4">
					<div class="card shadow-sm h-100">
						<div class="card-body text-center">
							<h5 class="card-title">Chansons</h5>
							<p class="card-text">Écoute les derniers titres.</p>
							<a href="{{ path('app_song_index') }}" class="btn btn-outline-primary">
								Voir les chansons
							</a>
						</div>
					</div>
				</div>

				<div class="col-md-4">
					<div class="card shadow-sm h-100">
						<div class="card-body text-center">
							<h5 class="card-title">À propos</h5>
							<p class="card-text">Découvre l’histoire derrière Konvix Music.</p>
							<a href="{{ path('app_about') }}" class="btn btn-outline-primary">
								En savoir plus
							</a>
						</div>
					</div>
				</div>

				<div class="col-md-4">
					<div class="card shadow-sm h-100">
						<div class="card-body text-center">
							<h5 class="card-title">Contact</h5>
							<p class="card-text">Envoyer un message ou une demande.</p>
							<a href="{{ path('app_contact') }}" class="btn btn-outline-primary">
								Me contacter
							</a>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<div
		class="container py-5">

		<!-- HERO -->
		<div class="text-center mb-5">
			<h1 class="display-4 fw-bold">Bienvenue sur Konvix Music</h1>
			<p class="lead mt-3">
				Découvrez mes chansons, mes projets musicaux et mes créations originales.
			</p>
			<a href="#" class="btn btn-primary btn-lg mt-3">Explorer mes titres</a>
		</div>

		<!-- SECTION TITRES -->
		<h2 class="text-center mb-4">Mes dernières créations</h2>

		<div class="row home-latest-grid g-3 mt-4">
			{% for song in latestSongs %}
				{% set songSlug = song.slug ?? null %}
				{% set songCategoryName = song.category ? song.category.name : 'Divers' %}
				<div class="col-6 col-sm-4 col-md-3 col-lg-2">
					<div class="card shadow-sm h-100 border-0">
						{% if song.image %}
							<img src="{{ asset('uploads/covers/' ~ song.image) }}" class="card-img-top home-cover" alt="{{ song.title }}">
						{% endif %}

						<div class="card-body p-3">
							<h6 class="card-title mb-1">{{ song.title }}</h6>

							<p class="text-muted small mb-2">{{ songCategoryName }}</p>

							{% if songSlug %}
								<a href="{{ path('app_song_show', { slug: songSlug }) }}" class="btn btn-primary btn-sm w-100">
									Écouter
								</a>
							{% else %}
								<span class="btn btn-secondary btn-sm disabled w-100">Écouter</span>
							{% endif %}
						</div>
					</div>
				</div>
			{% endfor %}
		</div>


	</div>


{% endblock %}
