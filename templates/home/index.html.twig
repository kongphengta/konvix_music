{% extends 'base.html.twig' %}

{% block title %}Konvix Music | Accueil{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main class="app-shell">
        <section class="hero-section py-5 py-lg-0">
            <div class="container-fluid px-4 px-lg-5">
                <div class="row align-items-center min-vh-85 g-5">
                    <div class="col-12 col-lg-7">
                        <div class="hero-copy">
                            <p class="eyebrow text-uppercase mb-3">Konvix Music</p>
                            <h1 class="display-3 fw-bold mb-4">Your music,<br>your image, your identity.</h1>
                            <p class="lead mb-4 text-secondary-light">
                                Une plateforme premium pour les artistes indépendants : publication, branding, découverte et écoute dans un univers ultra sombre et lumineux.
                            </p>

                            <div class="d-flex flex-wrap gap-3">
                                <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-4 py-3">Créer un compte</a>
                                <a href="{{ path('app_verify') }}" class="btn btn-outline-light btn-lg px-4 py-3">Vérifier mon code</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-5">
                        <div class="feature-card">
                            <div class="feature-card-inner">
                                <div class="brand-mark">♪</div>
                                <h2 class="h3 fw-bold mb-2">Konvix Music</h2>
                                <p class="mb-0 text-secondary-light">Studio audio • Labels • Découverte</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="container-fluid px-4 px-lg-5 pb-5">
            <div class="row g-4">
                <div class="col-12 col-lg-4">
                    <article class="media-card">
                        <div class="media-label">Playlist</div>
                        <h3>Night Drive</h3>
                        <p>Ambiance électronique et textures profondes pour les soirées lentes et les trajets lumineux.</p>
                    </article>
                </div>

                <div class="col-12 col-lg-4">
                    <article class="media-card primary">
                        <div class="media-label">Featured</div>
                        <h3>Le Code</h3>
                        <p>Une énergie digitale, synthétique et moderne conçue pour les artistes qui veulent se distinguer.</p>
                    </article>
                </div>

                <div class="col-12 col-lg-4">
                    <article class="media-card">
                        <div class="media-label">New</div>
                        <h3>Hits Français</h3>
                        <p>Des morceaux qui allient culture urbaine, voix et textures club.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="music-showcase container-fluid px-4 px-lg-5">
            <div class="section-heading">
                <div>
                    <span class="section-tag">À l’écoute</span>
                    <h2 class="mt-3">Le son du moment</h2>
                </div>
                <a href="#" class="btn btn-outline-light btn-sm px-3">Voir la radio</a>
            </div>

            <div class="playlist-panel" data-player-playlist>
                {% if tracks is not empty %}
                    {% for track in tracks %}
                        {% set audioUrl = track.audioFileName ? asset('uploads/tracks/audio/' ~ track.audioFileName) : null %}
                        <div class="track-row{% if loop.first %} is-active{% endif %}" data-track-title="{{ track.title }}" data-track-artist="{{ track.artistName }}" data-track-url="{{ audioUrl ?? '' }}" data-track-cover="{{ track.coverFileName ? asset('uploads/tracks/covers/' ~ track.coverFileName) : '' }}">
                            <div class="track-cover">{{ loop.index <= 9 ? '0' ~ loop.index : loop.index }}</div>
                            <div class="track-info">
                                <span class="track-title">{{ track.title }}</span>
                                <span class="track-meta">{{ track.artistName }} • {{ track.createdAt|date('d/m/Y') }}</span>
                            </div>
                            <span class="play-badge">{{ track.artistCity }}</span>
                            <span class="track-duration">{{ audioUrl ? 'À l’écoute' : 'Prêt' }}</span>
                            <button class="btn btn-link p-0 text-white-50 track-play-btn" type="button" aria-label="Lecture {{ track.title }}">▶</button>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="track-row">
                        <div class="track-cover">♪</div>
                        <div class="track-info">
                            <span class="track-title">Aucun morceau publié</span>
                            <span class="track-meta">Les artistes apparaîtront ici dès qu’ils téléverseront un son.</span>
                        </div>
                        <span class="play-badge">Rien</span>
                        <span class="track-duration">--:--</span>
                        <button class="btn btn-link p-0 text-white-50" type="button" aria-label="Lecture vide" disabled>▶</button>
                    </div>
                {% endif %}
            </div>

            <div class="player-bar">
                <div class="player-panel row align-items-center g-3">
                    <div class="col-12 col-md-auto d-flex align-items-center gap-3">
                        <div class="player-art" id="player-art">♪</div>
                        <div>
                            <div class="fw-semibold text-white" id="player-title">Aucun morceau</div>
                            <div class="text-white-50 small" id="player-artist">Choisissez une piste</div>
                        </div>
                    </div>

                    <div class="col-12 col-md">
                        <div class="player-controls mb-2">
                            <button class="control-btn" type="button" id="prev-track" aria-label="Précédent">⏮</button>
                            <button class="control-btn primary" type="button" id="play-toggle" aria-label="Lecture">▶</button>
                            <button class="control-btn" type="button" id="next-track" aria-label="Suivant">⏭</button>
                        </div>

                        <div class="player-progress">
                            <span class="player-time" id="current-time">0:00</span>
                            <div class="progress" aria-label="Progression de lecture">
                                <div class="progress-bar" role="progressbar" id="progress-bar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span class="player-time" id="duration-time">0:00</span>
                        </div>
                    </div>

                    <div class="col-12 col-md-auto player-volume">
                        <span class="text-white-50">🔊</span>
                        <input class="form-range" type="range" min="0" max="100" value="72" aria-label="Volume" id="volume-control" />
                    </div>
                </div>
            </div>
        </section>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
