<header class="site-header">
    <div class="container navbar">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Konvix Music">
            <span class="brand-mark">♪</span>
            <span>Konvix Music</span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Ouvrir le menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="nav-links" id="primary-nav" aria-label="Navigation principale">
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="{{ path('app_discover') }}">Découvrir</a>
            <a href="{{ path('app_playlists') }}">Playlists</a>
            <a href="{{ path('app_artists') }}">Artistes</a>
            <a href="{{ path('app_home') }}#newsletter">Newsletter</a>
        </nav>

        <div class="nav-actions">
            {% if app.user %}
                <span class="welcome-user">Bonjour, {{ app.user.firstName ?: app.user.email }}</span>
                {% set effectiveRoles = app.user.getRoles() %}
                {% if 'ROLE_ADMIN' in effectiveRoles or app.user.accountType == 'admin' %}
                    <a class="btn btn-secondary" href="{{ path('admin') }}">Mon espace</a>
                {% elseif 'ROLE_ARTISTE' in effectiveRoles or app.user.accountType == 'artist' %}
                    <a class="btn btn-secondary" href="{{ path('app_artist_dashboard') }}">Mon espace</a>
                {% else %}
                    <a class="btn btn-secondary" href="{{ path('app_become_artist') }}">Devenir artiste</a>
                {% endif %}

                <form method="post" action="{{ path('app_logout') }}" class="logout-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="btn btn-primary">Déconnexion</button>
                </form>
            {% else %}
                <a class="btn btn-secondary" href="{{ path('app_register_role', { accountType: 'artist' }) }}">S'inscrire artiste</a>
                <a class="btn btn-secondary" href="{{ path('app_register_role', { accountType: 'auditeur' }) }}">S'inscrire auditeur</a>
                <a class="btn btn-primary" href="{{ path('app_login') }}">Connexion</a>
            {% endif %}
        </div>
    </div>
</header>
