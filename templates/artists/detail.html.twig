{% extends 'base.html.twig' %}

{% block title %}{{ artist.name }} | Konvix Music{% endblock %}

{% block body %}
    {% include '_partials/header.html.twig' %}

    <main>
        <section class="page-hero">
            <div class="container page-hero-inner artist-detail-hero">
                <div>
                    <span class="eyebrow">Featured artist</span>
                    <h1>{{ artist.name }}</h1>
                    <p class="lead">
                        {{ artist.bio }}
                    </p>
                    <div class="artist-detail-meta">
                        <span>{{ artist.genre }}</span>
                        <span>{{ artist.city }}</span>
                        <span>{{ artist.followers }} followers</span>
                    </div>
                </div>
                <div class="artist-detail-aside artist-{{ artist.color }}">
                    <div class="artist-visual-large" aria-hidden="true"></div>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="section-header">
                    <h2>Tracks sélectionnés</h2>
                </div>

                <div class="detail-track-list">
                    {% for track in featured %}
                        <div class="detail-track-item">
                            <span class="track-badge">{{ loop.index }}</span>
                            <span class="track-name">{{ track }}</span>
                            <button type="button">Lire</button>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="section-header">
                    <h2>À découvrir aussi</h2>
                </div>

                <div class="detail-links">
                    <a href="{{ path('app_playlists') }}" class="btn btn-secondary">Voir les playlists</a>
                    <a href="{{ path('app_albums') }}" class="btn btn-primary">Explorer les albums</a>
                </div>
            </div>
        </section>
    </main>

    {% include '_partials/footer.html.twig' %}
{% endblock %}
