{% extends 'base.html.twig' %}

{% block title %}Recherche{% endblock %}

{% block body %}
<div class="container py-5">

    <h1 class="mb-4">Résultats pour : "{{ query }}"</h1>

    <form method="get" action="{{ path('app_songs_search') }}" class="mb-4">
        <input type="text" name="q" value="{{ query }}" class="form-control" placeholder="Rechercher une chanson...">
    </form>

    {% if songs is empty %}
        <p>Aucun résultat trouvé.</p>
    {% else %}
        <div class="row">
            {% for song in songs %}
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5>{{ song.title }}</h5>

                            <p class="text-muted">{{ song.category|capitalize }}</p>

                            <a href="{{ path('app_song_show', { slug: song.slug }) }}"
                               class="btn btn-primary btn-sm">
                                Écouter
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}
