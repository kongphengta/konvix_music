{% extends 'base.html.twig' %}

{% block title %}Liste des chansons
{% endblock %}

{% block body %}
	<div class="container mt-4">

		<h1 class="mb-4">🎵 Liste des chansons</h1>

		<a href="{{ path('app_song_new') }}" class="btn btn-success mb-4">
			➕ Ajouter une chanson
		</a>

		{% if songs is not empty %}
			<div class="row">
				{% for song in songs %}
					<div class="col-md-4 mb-4">
						<div class="card shadow-sm">

							{% if song.image %}
								<img src="{{ asset('uploads/covers/' ~ song.image) }}" class="card-img-top" alt="{{ song.title }}">
							{% endif %}

							<div class="card-body">
								<h5 class="card-title">{{ song.title }}</h5>

								<p class="text-muted mb-2">
									Catégorie :
									{{ song.category }}
								</p>

								<a href="{{ path('app_song_show', { slug: song.slug }) }}" class="btn btn-primary btn-sm">
									▶️ Écouter
								</a>
							</div>

						</div>
					</div>
				{% endfor %}
			</div>
		{% else %}
			<p class="text-muted">Aucune chanson pour le moment.</p>
		{% endif %}

	</div>
{% endblock %}
