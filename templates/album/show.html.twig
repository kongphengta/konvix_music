{% extends 'base.html.twig' %}

{% block title %}
	{{ album.title }}
{% endblock %}

{% block body %}

	<div class="album-header">
		<img src="/uploads/albums/{{ album.cover }}" class="album-cover" alt="{{ album.title }}">

		<div class="album-info">
			<h1>{{ album.title }}</h1>
			<p>{{ songs|length }} chansons</p>
		</div>
	</div>

	<h2 class="songs-title">Chansons</h2>

	<div class="songs-list">
		{% for song in songs %}
			<div class="song-row">
				<div class="song-left">
					<img src="/uploads/songs/{{ song.image }}" class="song-cover" alt="{{ song.title }}">
					<span class="song-title">{{ song.title }}</span>
				</div>

				<a href="{{ path('app_song_show', { slug: song.slug }) }}" class="play-btn">
					Écouter →
				</a>
			</div>
		{% else %}
			<p>Aucune chanson dans cet album.</p>
		{% endfor %}
	</div>

{% endblock %}
