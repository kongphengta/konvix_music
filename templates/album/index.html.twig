{% extends 'base.html.twig' %}

{% block title %}Albums
{% endblock %}

{% block body %}
	<div class="albums-header">
		<h1>Albums</h1>
	</div>

	<div class="spotify-grid">
		{% for album in albums %}
			<div class="spotify-card">
				<div class="cover-wrapper">
					<img src="/uploads/albums/{{ album.cover }}" alt="{{ album.title }}" class="cover-img">
				</div>

				<div class="album-info">
					<h3 class="album-title">{{ album.title }}</h3>

					<a href="{{ path('app_album_show', { slug: album.slug }) }}" class="open-btn">
						Ouvrir →
					</a>
				</div>
			</div>
		{% else %}
			<p>Aucun album trouvé.</p>
		{% endfor %}
	</div>

	<style>
		/* HEADER */
		.albums-header {
			margin-bottom: 30px;
		}
		.albums-header h1 {
			font-size: 42px;
			font-weight: 700;
			color: #fff;
		}

		/* GRID */
		.spotify-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
			gap: 25px;
		}

		/* CARD */
		.spotify-card {
			background: #181818;
			padding: 18px;
			border-radius: 12px;
			transition: transform 0.2s, background 0.2s;
			cursor: pointer;
		}
		.spotify-card:hover {
			background: #282828;
			transform: scale(1.03);
		}

		/* COVER */
		.cover-wrapper {
			width: 100%;
			aspect-ratio: 1 / 1;
			overflow: hidden;
			border-radius: 8px;
			margin-bottom: 12px;
		}
		.cover-img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		/* TEXT */
		.album-title {
			font-size: 18px;
			font-weight: 600;
			color: #fff;
			margin-bottom: 10px;
		}

		/* BUTTON */
		.open-btn {
			display: inline-block;
			padding: 6px 12px;
			background: #1DB954;
			color: #fff;
			border-radius: 20px;
			text-decoration: none;
			font-size: 14px;
			transition: background 0.2s;
		}
		.open-btn:hover {
			background: #1ed760;
		}
	</style>

{% endblock %}
